{
  "meta": {
    "label": "Better Notebooks",
    "description": "A modern notebook workspace prototype for a Dataiku project.",
    "icon": "icon-book"
  },
  "baseType": "STANDARD",
  "hasBackend": true,
  "noJSSecurity": false,
  "standardWebAppLibraries": [
    "jquery",
    "dataiku"
  ],
  "params": [
    {
      "name": "storage_namespace",
      "label": "Browser storage namespace",
      "type": "STRING",
      "defaultValue": "better-notebooks"
    },
    {
      "name": "coding_llm_id",
      "label": "Coding assistant LLM Mesh ID",
      "type": "STRING",
      "defaultValue": "",
      "description": "Optional LLM Mesh ID for cell assistance. Leave blank to use the first text-generation model accessible in this project."
    },
    {
      "name": "result_snapshot_mib",
      "label": "Maximum snapshot size (MiB)",
      "type": "INT",
      "defaultValue": 128
    },
    {
      "name": "result_kernel_mib",
      "label": "Snapshot budget per kernel (MiB)",
      "type": "INT",
      "defaultValue": 256
    },
    {
      "name": "result_ttl_minutes",
      "label": "Snapshot inactivity expiry (minutes)",
      "type": "INT",
      "defaultValue": 30
    },
    {
      "name": "result_export_mib",
      "label": "Browser CSV export limit (MiB)",
      "type": "INT",
      "defaultValue": 100
    }
  ],
  "roles": []
}
